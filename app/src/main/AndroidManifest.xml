<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/icon"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.TmapNda">

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity
            android:name=".MapActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <!-- v3.4: 스티어링휠 마이크 버튼을 헤드유닛이 "기본 음성 비서 실행" 인텐트로
                 처리하는 경우 대비 - 정확히 어떤 방식을 쓰는 헤드유닛인지 몰라서
                 여러 경로를 동시에 걸어둠(#문제시 원복). 실차에서 버튼 눌러보고
                 로그(VOICE_BTN)에 뭐가 찍히는지 확인 필요. -->
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".KakaoNaviActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        
        <service
            android:name=".UdpSenderService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- v4.24: "순정 티맵은 HUD 되는데 TmapNda 카카오는 안 된다"(사용자, 반복 지적) -
             순정 티맵 APK를 까봐서 비교한 결과, TmapCarAppService가 NAVIGATION과 함께
             FEATURE_CLUSTER 카테고리도 선언하고 있었음. 예전 코멘트("계기판 지도를 직접
             그리는 기능이라 별개")는 잘못된 판단이었음 - FEATURE_CLUSTER는 Android Auto
             호스트에게 "이 앱이 계기판/클러스터에도 렌더링할 의사가 있다"는 걸 알리는
             카테고리라, 이게 없으면 호스트가 애초에 클러스터용 세션 생성 시도 자체를
             안 함(TmapNdaHud 로그가 계속 0건이었던 것과 정확히 일치). 추가함. #문제시 원복 -->
        <service
            android:name=".hud.TmapNdaCarAppService"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
                <category android:name="androidx.car.app.category.FEATURE_CLUSTER" />
            </intent-filter>
        </service>
            
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
