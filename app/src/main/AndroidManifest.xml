<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- v: 지금까지 IP 대역으로만 "와이파이인지 모바일인지" 추측했는데, 이 권한으로
         실제 연결된 Wi-Fi 이름(SSID)까지 로그에 정확히 남길 수 있음 - 클라이언트
         모드(남의 핫스팟에 붙음)/호스트 모드(내가 핫스팟 켬) 구분이 훨씬 확실해짐. #문제시 원복 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- v: 배터리 최적화(Doze/앱 대기 모드) 예외를 요청하기 위한 권한. 지금까지 이걸 아예
         요청한 적이 없어서, 헤드유닛의 배터리 최적화 정책에 따라 UdpSenderService의
         백그라운드 네트워크(UDP)가 한동안 잘 되다가 조용히 조여질 수 있었음("연결 한 번
         되고 다시는 안 됨" 미스터리의 추가 원인 후보). #문제시 원복 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- v: 사용자 요청(재억, 2026-08-12) - Android Auto 포그라운드 감지(클러스터 세션 기능
         조사용). 런타임 권한이 아니라 설정 앱에서 "사용정보 접근"을 수동으로 허용해야
         동작함(AutoWatchHelper.hasUsageAccessPermission() 참고). #문제시 원복 -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <!-- v: 재억 요청(2026-08-27) - Navdy(애프터마켓 HUD) 자동연결에 필요한 런타임 권한.
         선언만 해두고 실제 요청 로직이 없어서 안드로이드 12+에서는 항상 거부 상태로 남아
         자동연결이 매번 조용히 건너뛰어지고 있었음 - MainActivity의 요청 흐름과 함께 추가. #문제시 원복 -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- v: 재억 제보(2026-08-27, 실기기 로그로 확인) - Navdy 연결이 매번 실패하던 진짜 원인.
         BLUETOOTH_CONNECT만 있으면 되는 줄 알았는데, 연결 전 cancelDiscovery() 호출에는
         안드로이드 12+에서 BLUETOOTH_SCAN 권한이 별도로 필요함(SecurityException으로 확인).
         스캔 결과로 위치를 추정하는 기능이 없어서 neverForLocation으로 선언 - 이러면 위치
         권한 없이도 이 권한만 허용받으면 됨. #문제시 원복 -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <!-- v: 재억 요청(2026-08-27) - 앱이 백그라운드로 내려가도 다음 방향 안내를 계속 볼 수 있게
         화면 위에 작은 오버레이를 띄우는 기능(NavOverlayManager)에 필요한 권한. 런타임에
         일반 requestPermissions로는 못 받고, 시스템 설정 화면(ACTION_MANAGE_OVERLAY_PERMISSION)에서
         사용자가 직접 허용해야 함. #문제시 원복 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />

    <!-- v: 스톡 Tmap 매니페스트를 디컴파일해서 비교한 결과, Android 11+ 패키지 가시성 제한
         대응을 위해 Android Auto 호스트(gearhead) 패키지를 queries에 명시하고 있었음.
         우리 쪽에는 queries 블록 자체가 없었어서 동일하게 추가함. #문제시 원복 -->
    <queries>
        <package android:name="com.google.android.projection.gearhead" />
        <!-- v: 재억 제보(2026-09-03) - 카카오 안내를 차량 순정 계기판/HUD에 띄우려면
             nMirror가 열어둔 길안내 창구에 붙어야 하는데, Android 11+에서는 여기 적어두지
             않으면 그 앱이 설치돼 있어도 보이지 않아 연결 자체가 안 된다. #문제시 원복 -->
        <package android:name="com.aa.nmirror" />
    </queries>

    <!-- v: 재억 제보(2026-08-22) - 콤마로 경로선을 보내는 HTTP 채널(7713번 포트)이 로그상
         단 한 번도 성공한 적 없음(UDP는 정상). 원인 - 안드로이드는 API 28부터 암호화 안 된
         일반 http:// 통신을 기본 차단하는데, usesCleartextTraffic이 없어서 요청이 나가기도
         전에 시스템이 막고 있었음. 콤마는 항상 같은 차 안 사설 네트워크에 있는 로컬 기기라
         암호화가 필요 없는 통신 상대라서 허용함. #문제시 원복 -->
    <application
        android:allowBackup="true"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/icon"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.TmapNda">

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- v: 분할화면(멀티윈도우)으로 들어가면 화면 크기가 바뀌는데, 아래 configChanges
             지시가 없어서 안드로이드가 내비게이션 화면을 통째로 부쉈다가 다시 만들었음
             (콤마 연결도 그 과정에서 같이 끊김). 카카오내비 화면(KakaoNaviActivity)엔
             이미 있던 지시를 여기에도 추가함. #문제시 원복: configChanges, resizeableActivity
             두 줄 지우면 원래대로 -->
        <activity
            android:name=".MapActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density">
            <!-- v3.4: 스티어링휠 마이크 버튼을 헤드유닛이 "기본 음성 비서 실행" 인텐트로
                 처리하는 경우 대비 - 정확히 어떤 방식을 쓰는 헤드유닛인지 몰라서
                 여러 경로를 동시에 걸어둠(#문제시 원복). 실차에서 버튼 눌러보고
                 로그(VOICE_BTN)에 뭐가 찍히는지 확인 필요. -->
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- v: MapActivity와 동일한 이유(분할화면 등으로 화면 크기가 바뀔 때 액티비티가
             통째로 재생성되면서 카카오 SDK 델리게이트가 유실돼 Navdy HUD 데이터가
             끊기는 문제, 재억 제보 로그로 확인)로 여기도 동일하게 추가. #문제시 원복 -->
        <activity
            android:name=".KakaoNaviActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density" />
        
        <service
            android:name=".UdpSenderService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- v4.24: "순정 티맵은 HUD 되는데 TmapNda 카카오는 안 된다"(사용자, 반복 지적) -
             순정 티맵 APK를 까봐서 비교한 결과, TmapCarAppService가 NAVIGATION과 함께
             FEATURE_CLUSTER 카테고리도 선언하고 있었음. 예전 코멘트("계기판 지도를 직접
             그리는 기능이라 별개")는 잘못된 판단이었음 - FEATURE_CLUSTER는 Android Auto
             호스트에게 "이 앱이 계기판/클러스터에도 렌더링할 의사가 있다"는 걸 알리는
             카테고리라, 이게 없으면 호스트가 애초에 클러스터용 세션 생성 시도 자체를
             안 함(TmapNdaHud 로그가 계속 0건이었던 것과 정확히 일치). 추가함. #문제시 원복 -->
        <service
            android:name=".hud.TmapNdaCarAppService"
            android:exported="true"
            android:foregroundServiceType="location"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
                <category android:name="androidx.car.app.category.FEATURE_CLUSTER" />
            </intent-filter>
        </service>
            
        <!-- v: 신규기능(미니 플레이어) - 재억 요청(2026-08-28). 지금 재생 중인 음악 정보를
             MediaSessionManager로 읽어오려면 이 서비스가 등록돼 있어야 하고, 사용자가
             시스템 설정(알림 접근)에서 허용해야 함. 알림 내용 자체는 안 씀. #문제시 원복 -->
        <service
            android:name=".miniplayer.MiniPlayerNotificationListener"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
