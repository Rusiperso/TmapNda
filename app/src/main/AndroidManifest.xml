<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- v: 지금까지 IP 대역으로만 "와이파이인지 모바일인지" 추측했는데, 이 권한으로
         실제 연결된 Wi-Fi 이름(SSID)까지 로그에 정확히 남길 수 있음 - 클라이언트
         모드(남의 핫스팟에 붙음)/호스트 모드(내가 핫스팟 켬) 구분이 훨씬 확실해짐. #문제시 원복 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- v: 배터리 최적화(Doze/앱 대기 모드) 예외를 요청하기 위한 권한. 지금까지 이걸 아예
         요청한 적이 없어서, 헤드유닛의 배터리 최적화 정책에 따라 UdpSenderService의
         백그라운드 네트워크(UDP)가 한동안 잘 되다가 조용히 조여질 수 있었음("연결 한 번
         되고 다시는 안 됨" 미스터리의 추가 원인 후보). #문제시 원복 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- v: 사용자 요청(재억, 2026-08-12) - Android Auto 포그라운드 감지(클러스터 세션 기능
         조사용). 런타임 권한이 아니라 설정 앱에서 "사용정보 접근"을 수동으로 허용해야
         동작함(AutoWatchHelper.hasUsageAccessPermission() 참고). #문제시 원복 -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />

    <!-- v: 스톡 Tmap 매니페스트를 디컴파일해서 비교한 결과, Android 11+ 패키지 가시성 제한
         대응을 위해 Android Auto 호스트(gearhead) 패키지를 queries에 명시하고 있었음.
         우리 쪽에는 queries 블록 자체가 없었어서 동일하게 추가함. #문제시 원복 -->
    <queries>
        <package android:name="com.google.android.projection.gearhead" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/icon"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.TmapNda">

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity
            android:name=".MapActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <!-- v3.4: 스티어링휠 마이크 버튼을 헤드유닛이 "기본 음성 비서 실행" 인텐트로
                 처리하는 경우 대비 - 정확히 어떤 방식을 쓰는 헤드유닛인지 몰라서
                 여러 경로를 동시에 걸어둠(#문제시 원복). 실차에서 버튼 눌러보고
                 로그(VOICE_BTN)에 뭐가 찍히는지 확인 필요. -->
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".KakaoNaviActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        
        <service
            android:name=".UdpSenderService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- v4.24: "순정 티맵은 HUD 되는데 TmapNda 카카오는 안 된다"(사용자, 반복 지적) -
             순정 티맵 APK를 까봐서 비교한 결과, TmapCarAppService가 NAVIGATION과 함께
             FEATURE_CLUSTER 카테고리도 선언하고 있었음. 예전 코멘트("계기판 지도를 직접
             그리는 기능이라 별개")는 잘못된 판단이었음 - FEATURE_CLUSTER는 Android Auto
             호스트에게 "이 앱이 계기판/클러스터에도 렌더링할 의사가 있다"는 걸 알리는
             카테고리라, 이게 없으면 호스트가 애초에 클러스터용 세션 생성 시도 자체를
             안 함(TmapNdaHud 로그가 계속 0건이었던 것과 정확히 일치). 추가함. #문제시 원복 -->
        <service
            android:name=".hud.TmapNdaCarAppService"
            android:exported="true"
            android:foregroundServiceType="location"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
                <category android:name="androidx.car.app.category.FEATURE_CLUSTER" />
            </intent-filter>
        </service>
            
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
