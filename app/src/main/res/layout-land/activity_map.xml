<?xml version="1.0" encoding="utf-8"?>
<!-- 스타일 D: 좌측 세로 HUD + 우측 지도 풀스크린 -->
<!-- 지도(tmapUILayout)를 실제로 풀스크린 폭으로 두고, 좌측 HUD는 그 위에 얹는 불투명 오버레이로 변경.
     이유: Tmap SDK NavigationFragment가 내부적으로 일부 위젯(오프셋/상태 배지 등)을
     "화면 전체 폭" 기준 절대좌표로 배치하는 것으로 추정됨. 예전처럼 LinearLayout(weight)로
     지도 컨테이너 폭을 220dp만큼 줄여두면, SDK 내부 절대좌표 계산은 여전히 전체 폭 기준이라
     일부 위젯이 HUD 패널과 지도 경계선에 걸쳐서 겹쳐 보이는 문제가 있었음.
     지도 컨테이너를 전체 폭으로 주고, HUD는 불투명 배경으로 그 위에 덮어써서 경계 문제를 회피. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080808">

    <!-- ===== 좌측 HUD 패널 (지도 위 오버레이, 불투명 배경으로 그 아래 겹치는 SDK 위젯을 가림) ===== -->
    <LinearLayout
        android:id="@+id/llLeftHudPanel"
        android:layout_width="220dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:elevation="20dp"
        android:orientation="vertical"
        android:background="#080808"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:paddingHorizontal="12dp">

        <!-- 1. 속도계 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPEED"
                android:textColor="#333333"
                android:textSize="9sp"
                android:letterSpacing="0.15"
                android:layout_marginBottom="2dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/tvCurrentSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="60sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.05"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="km/h"
                        android:textColor="#444444"
                        android:textSize="9sp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="제한"
                            android:textColor="#555555"
                            android:textSize="8sp"
                            android:layout_marginEnd="3dp"/>

                        <TextView
                            android:id="@+id/tvRoadSpeedLimit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="#FF5252"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_speed_limit_hud"
                            android:paddingHorizontal="5dp"
                            android:paddingVertical="1dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A1A1A" android:layout_marginBottom="8dp"/>

        <!-- 2. OP 상태 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STATUS"
                android:textColor="#333333"
                android:textSize="9sp"
                android:letterSpacing="0.15"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvActiveStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OP OFF"
                android:textColor="#555555"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <View
                    android:id="@+id/vConnectionDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/shape_circle_gray"
                    android:layout_marginEnd="5dp"/>

                <TextView
                    android:id="@+id/tvConnectionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="연결 대기"
                    android:textColor="#555555"
                    android:textSize="10sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvXStateBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#4FC3F7"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A1A1A" android:layout_marginBottom="8dp"/>

        <!-- 3. 카메라/방지턱 이벤트 -->
        <LinearLayout
            android:id="@+id/llSdiInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EVENT"
                android:textColor="#333333"
                android:textSize="9sp"
                android:letterSpacing="0.15"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvSdiDescr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#FFC107"
                android:textSize="11sp"
                android:layout_marginBottom="2dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/tvSdiDist"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="none"/>

                <TextView
                    android:id="@+id/tvSdiSpeedLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FF5252"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="4dp"/>
            </LinearLayout>

            <!-- 구간단속 상세 (tvSdiDescr에 이미 "구간단속 중" 표시되므로 제목 중복 제거) -->
            <LinearLayout
                android:id="@+id/llBlockInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp"
                android:visibility="gone">

                <!-- tvOffsetTitle: 세로모드 호환용으로 gone 처리 -->
                <TextView
                    android:id="@+id/tvOffsetTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="구간단속"
                    android:textColor="#FFC107"
                    android:textSize="10sp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvBlockAvgSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvBlockDist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tvBlockTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A1A1A" android:layout_marginBottom="8dp"/>

        <!-- 4. 신호등 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <View
                android:id="@+id/vTrafficLight"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/shape_circle_gray"
                android:layout_marginEnd="8dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SIGNAL"
                    android:textColor="#333333"
                    android:textSize="8sp"/>

                <TextView
                    android:id="@+id/tvCarrotVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#555555"
                    android:textSize="9sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 5. GPS 상태 버튼 -->
        <Button
            android:id="@+id/btnGpsStatus"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:text="GPS 확인 중"
            android:textSize="9sp"
            android:padding="0dp"
            android:backgroundTint="#111111"
            android:layout_marginBottom="4dp"/>

        <!-- 6. OP IP -->
        <TextView
            android:id="@+id/tvCarrotIp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IP: -"
            android:textColor="#333333"
            android:textSize="9sp"
            android:layout_marginBottom="4dp"/>

        <!-- spacer -->
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

        <!-- 음소거 | 검색 | 전송 (패널 밖 지도 위에 떠 있으면 이 패널에 가려지므로 패널 안으로 이동) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <ImageButton
                android:id="@+id/btnMuteToggle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:src="@android:drawable/ic_lock_silent_mode"
                android:background="@drawable/shape_circle_gray"
                android:scaleType="center"/>

            <ImageButton
                android:id="@+id/btnOpenSearch"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:src="@android:drawable/ic_menu_search"
                android:background="@drawable/shape_circle_gray"
                android:scaleType="center"/>

            <ImageButton
                android:id="@+id/btnShareLog"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:src="@android:drawable/ic_menu_send"
                android:background="@drawable/shape_circle_gray"
                android:scaleType="center"/>
        </LinearLayout>

        <!-- 최근 검색 이력 (최근 3개 상시 표시 + 더보기) -->
        <LinearLayout
            android:id="@+id/llRecentSearchPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="최근 검색"
                android:textColor="#666666"
                android:textSize="9sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#141414">

                <!-- 상시 표시는 최근 1개만: 이력이 늘어날 때마다 이 패널 높이가 커져서
                     하단 "앱 종료" 버튼이 화면 밖으로 밀려나는 문제가 있었음. 나머지는
                     "+ 더보기"로 전체 다이얼로그에서 확인. #문제시 원복 -->
                <TextView
                    android:id="@+id/tvRecentSearch1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="9dp"
                    android:textColor="#DDDDDD"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnMoreHistory"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="4dp"
                android:text="+ 더보기"
                android:textSize="11sp"
                android:textColor="#888888"
                android:background="@drawable/shape_circle_gray"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>
        </LinearLayout>

        <!-- 7. 하단 버튼들 -->
        <Button
            android:id="@+id/btnEditKey"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="설정"
            android:textSize="13sp"
            android:padding="0dp"
            android:backgroundTint="#111111"
            android:textColor="#888888"
            android:layout_marginBottom="6dp"/>

        <Button
            android:id="@+id/btnCheckUpdate"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="업데이트 확인"
            android:textSize="13sp"
            android:padding="0dp"
            android:backgroundTint="#111111"
            android:textColor="#888888"
            android:layout_marginBottom="6dp"/>

        <Button
            android:id="@+id/btnExitApp"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="앱 종료"
            android:textSize="13sp"
            android:padding="0dp"
            android:backgroundTint="#1A0000"
            android:textColor="#EF5350"/>

        <TextView
            android:id="@+id/tvAppVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#222222"
            android:textSize="9sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"/>

    </LinearLayout>

    <!-- ===== 지도 영역: 실제로는 전체 화면 폭 (SDK 내부 절대좌표 위젯과 좌표계를 맞추기 위함) ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/tmapUILayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- 지도 터치 무력화 -->
        <View
            android:id="@+id/vTouchLockOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#00000000"/>

        <!-- 구간단속 플로팅 패널 (드래그 가능) -->
        <LinearLayout
            android:id="@+id/llOffset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_sdi_panel"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:gravity="center"
            android:elevation="6dp"
            android:visibility="gone"/>

        <!-- 음소거/검색/전송 버튼은 좌측 HUD 패널 안으로 이동함 (llLeftHudPanel 참고) -->

        <!-- 목적지 검색 패널 -->
        <LinearLayout
            android:id="@+id/llSearchPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="bottom"
            android:layout_marginStart="220dp"
            android:background="#EE111111"
            android:padding="12dp"
            android:elevation="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etDestination"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:hint="목적지를 입력하세요 (예: 서울역)"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:background="@drawable/bg_sdi_panel"
                    android:paddingHorizontal="10dp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"
                    android:inputType="text" />

                <ImageButton
                    android:id="@+id/btnVoiceSearch"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:src="@android:drawable/ic_btn_speak_now"
                    android:background="@drawable/shape_circle_gray"
                    android:scaleType="center" />

                <Button
                    android:id="@+id/btnSearchGo"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:text="검색"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnSearchClose"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:text="닫기"
                    android:textSize="12sp"
                    android:backgroundTint="#555555" />
            </LinearLayout>

            <ListView
                android:id="@+id/lvSearchResults"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="6dp"
                android:divider="#33FFFFFF"
                android:dividerHeight="1dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvSearchStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textColor="#AAAAAA"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 길안내 중 표시 + 안내 종료 버튼 -->
        <LinearLayout
            android:id="@+id/llGuidanceBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="bottom"
            android:layout_marginStart="220dp"
            android:background="#EE1B5E20"
            android:padding="10dp"
            android:elevation="10dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvGuidanceDest"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="길안내 중"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStopGuidance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="안내 종료"
                android:textSize="11sp"
                android:backgroundTint="#F44336" />
        </LinearLayout>

    </FrameLayout>

    <!-- ===== 카카오내비 오버레이 (검색→길안내 시에만 Tmap 화면 위에 얹힘, 평소엔 GONE) =====
         layout_marginStart를 좌측 HUD 패널(220dp)만큼 줘서, Tmap 실제 지도가 보이던
         영역(HUD 제외 나머지)만큼만 차지하게 함. 이전엔 match_parent라 HUD 패널 위까지
         덮어서 화면이 과하게 커 보였음. #문제시 원복 -->
    <FrameLayout
        android:id="@+id/flKakaoOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="220dp"
        android:visibility="gone"
        android:elevation="50dp"
        android:background="#000000">

        <ViewStub
            android:id="@+id/naviViewStub"
            android:layout="@layout/kakao_navi_view_stub"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/btnStopKakaoGuidance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:text="안내 종료"
            android:backgroundTint="#F44336" />
    </FrameLayout>

</FrameLayout>
