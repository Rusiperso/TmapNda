<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#222222">

    <!-- 왼쪽 지도 영역 -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        
        <FrameLayout
            android:id="@+id/tmapUILayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Tmap 지도 터치 무력화: 항상 터치를 가로채서 하위 NavigationFragment(지도)로 전달 안 함.
             대시보드/버튼류보다 z-order상 아래에 있어 그것들은 정상적으로 클릭 가능. -->
        <View
            android:id="@+id/vTouchLockOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#00000000" />

        <!-- 주행 정보 오버레이 통합 대시보드 -->
        <LinearLayout
            android:id="@+id/llRoadInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_sdi_panel"
            android:layout_margin="16dp"
            android:paddingVertical="8dp"
            android:paddingHorizontal="4dp"
            android:layout_gravity="top|start"
            android:gravity="center_vertical"
            android:elevation="6dp">

            <!-- 1. 현재 속도, 제한 속도 패널 -->
            <LinearLayout
                android:id="@+id/llRoadSpeedLimit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_us_speed_limit"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SPEED"
                    android:textColor="#000000"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIMIT"
                    android:textColor="#000000"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRoadSpeedLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="#000000"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#33FFFFFF"
                android:layout_marginVertical="8dp"/>

            <!-- 2. 남은 거리 및 이벤트 패널 -->
            <LinearLayout
                android:id="@+id/llSdiEvent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:gravity="center">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_speed_limit"/>
                    <TextView
                        android:id="@+id/tvEventSpeedLimit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="60"
                        android:textColor="#000000"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvEventDist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="300m"
                    android:textColor="#FFEB3B"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvEventType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="단속"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <View
                android:id="@+id/vDividerSdi"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#33FFFFFF"
                android:layout_marginVertical="8dp"/>

            <!-- 3. GPS 상태 패널 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPS"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvGpsStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="확인 중"
                    android:textColor="#FFEB3B"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#33FFFFFF"
                android:layout_marginVertical="8dp"/>

            <!-- 4. Openpilot 상태 패널 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvActiveStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OP OFF"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_status_off"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="신호:"
                        android:textColor="#AAAAAA"
                        android:textSize="10sp" />
                    <View
                        android:id="@+id/vTrafficLight"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/shape_circle_gray"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvXStateBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CRUISE"
                    android:textColor="#2196F3"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>


        <!-- 지도 터치 방지용 투명 오버레이 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true" />
        <!-- 여유 가속 조절 플로팅 패널 -->
        <LinearLayout
            android:id="@+id/llOffset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="top|end"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_sdi_panel"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:gravity="center"
            android:elevation="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:id="@+id/tvOffsetTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="구간단속"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="여유가속"
                        android:textColor="#AAAAAA"
                        android:textSize="12sp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnOffsetInfo"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:text="?"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:padding="0dp"
                    android:background="@drawable/shape_circle_gray" />
            </LinearLayout>
                
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <Button
                    android:id="@+id/btnDecreaseOffset"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="-"
                    android:textSize="24sp"
                    android:padding="0dp"
                    android:backgroundTint="#555555"/>
                    
                <TextView
                    android:id="@+id/tvOffsetValue"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:textStyle="bold"/>
                    
                    <Button
                        android:id="@+id/btnIncreaseOffset"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="+"
                        android:textSize="24sp"
                        android:padding="0dp"
                        android:backgroundTint="#555555"/>
                </LinearLayout>

                <!-- 구간단속 정보 -->
                <LinearLayout
                    android:id="@+id/llBlockInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:visibility="gone">
                    
                    <TextView
                        android:id="@+id/tvBlockAvgSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="평균: 0km/h"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                        
                    <TextView
                        android:id="@+id/tvBlockDist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="거리: 0m"
                        android:textColor="#EEEEEE"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp" />
                        
                    <TextView
                        android:id="@+id/tvBlockTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="시간: 0:00"
                        android:textColor="#EEEEEE"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

        <!-- 오버레이 편집 모드 버튼 (그래픽) -->
        <ImageButton
            android:id="@+id/btnEditMode"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="32dp"
            android:src="@android:drawable/ic_menu_edit"
            android:background="@drawable/shape_circle_gray"
            android:scaleType="center"
            android:elevation="6dp" />
    </FrameLayout>

    <!-- 오른쪽 UI 영역 -->
    <LinearLayout
        android:layout_width="140dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:gravity="center_horizontal"
        android:background="#222222">

        <!-- 통합 컨트롤 패널 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_sdi_panel"
            android:padding="12dp"
            android:layout_marginTop="16dp">


            <!-- 연결 상태 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                
                <View
                    android:id="@+id/vConnectionDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/shape_circle_gray"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:id="@+id/tvConnectionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OP 연결 대기"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCarrotVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver: -"
                android:textColor="#AAAAAA"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/tvCarrotIp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IP: -"
                android:textColor="#888888"
                android:textSize="10sp"
                android:layout_marginBottom="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33FFFFFF"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnEditKey"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="설정"
                android:textSize="12sp"
                android:padding="0dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnExitApp"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="앱 종료"
                android:textSize="12sp"
                android:padding="0dp"
                android:backgroundTint="#F44336" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 앱 버전 -->
        <TextView
            android:id="@+id/tvAppVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v-"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_gravity="bottom|end"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

</LinearLayout>
