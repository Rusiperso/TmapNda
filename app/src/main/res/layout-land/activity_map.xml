<?xml version="1.0" encoding="utf-8"?>
<!-- 스타일 D: 좌측 세로 HUD + 우측 지도 풀스크린 -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#080808">

    <!-- ===== 좌측 HUD 패널 ===== -->
    <LinearLayout
        android:layout_width="220dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#080808"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:paddingHorizontal="12dp">

        <!-- 1. 속도계 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPEED"
                android:textColor="#333333"
                android:textSize="9sp"
                android:letterSpacing="0.15"
                android:layout_marginBottom="2dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/tvCurrentSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="60sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.05"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="km/h"
                        android:textColor="#444444"
                        android:textSize="9sp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="제한"
                            android:textColor="#555555"
                            android:textSize="8sp"
                            android:layout_marginEnd="3dp"/>

                        <TextView
                            android:id="@+id/tvRoadSpeedLimit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="#FF5252"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_speed_limit_hud"
                            android:paddingHorizontal="5dp"
                            android:paddingVertical="1dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A1A1A" android:layout_marginBottom="8dp"/>

        <!-- 2. OP 상태 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STATUS"
                android:textColor="#333333"
                android:textSize="9sp"
                android:letterSpacing="0.15"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvActiveStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OP OFF"
                android:textColor="#555555"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <View
                    android:id="@+id/vConnectionDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/shape_circle_gray"
                    android:layout_marginEnd="5dp"/>

                <TextView
                    android:id="@+id/tvConnectionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="연결 대기"
                    android:textColor="#555555"
                    android:textSize="10sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvXStateBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#4FC3F7"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A1A1A" android:layout_marginBottom="8dp"/>

        <!-- 3. 카메라/방지턱 이벤트 -->
        <LinearLayout
            android:id="@+id/llSdiInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EVENT"
                android:textColor="#333333"
                android:textSize="9sp"
                android:letterSpacing="0.15"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvSdiDescr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#FFC107"
                android:textSize="11sp"
                android:layout_marginBottom="2dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/tvSdiDist"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="none"/>

                <TextView
                    android:id="@+id/tvSdiSpeedLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FF5252"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="4dp"/>
            </LinearLayout>

            <!-- 구간단속 상세 (tvSdiDescr에 이미 "구간단속 중" 표시되므로 제목 중복 제거) -->
            <LinearLayout
                android:id="@+id/llBlockInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp"
                android:visibility="gone">

                <!-- tvOffsetTitle: 세로모드 호환용으로 gone 처리 -->
                <TextView
                    android:id="@+id/tvOffsetTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="구간단속"
                    android:textColor="#FFC107"
                    android:textSize="10sp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvBlockAvgSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvBlockDist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tvBlockTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A1A1A" android:layout_marginBottom="8dp"/>

        <!-- 4. 신호등 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <View
                android:id="@+id/vTrafficLight"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/shape_circle_gray"
                android:layout_marginEnd="8dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SIGNAL"
                    android:textColor="#333333"
                    android:textSize="8sp"/>

                <TextView
                    android:id="@+id/tvCarrotVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#555555"
                    android:textSize="9sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 5. GPS 상태 버튼 -->
        <Button
            android:id="@+id/btnGpsStatus"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:text="GPS 확인 중"
            android:textSize="9sp"
            android:padding="0dp"
            android:backgroundTint="#111111"
            android:layout_marginBottom="4dp"/>

        <!-- 6. OP IP -->
        <TextView
            android:id="@+id/tvCarrotIp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IP: -"
            android:textColor="#333333"
            android:textSize="9sp"
            android:layout_marginBottom="4dp"/>

        <!-- spacer -->
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

        <!-- 7. 하단 버튼들 -->
        <Button
            android:id="@+id/btnCheckUpdate"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:text="업데이트 확인"
            android:textSize="10sp"
            android:padding="0dp"
            android:backgroundTint="#111111"
            android:textColor="#888888"
            android:layout_marginBottom="4dp"/>

        <Button
            android:id="@+id/btnEditKey"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:text="설정"
            android:textSize="10sp"
            android:padding="0dp"
            android:backgroundTint="#111111"
            android:textColor="#888888"
            android:layout_marginBottom="4dp"/>

        <Button
            android:id="@+id/btnExitApp"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:text="앱 종료"
            android:textSize="10sp"
            android:padding="0dp"
            android:backgroundTint="#1A0000"
            android:textColor="#EF5350"/>

        <TextView
            android:id="@+id/tvAppVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#222222"
            android:textSize="9sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"/>

    </LinearLayout>

    <!-- ===== 우측 지도 영역 ===== -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/tmapUILayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- 지도 터치 무력화 -->
        <View
            android:id="@+id/vTouchLockOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#00000000"/>

        <!-- 구간단속 플로팅 패널 (드래그 가능) -->
        <LinearLayout
            android:id="@+id/llOffset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_sdi_panel"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:gravity="center"
            android:elevation="6dp"
            android:visibility="gone"/>

        <!-- 편집모드 버튼 -->
        <ImageButton
            android:id="@+id/btnEditMode"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:src="@android:drawable/ic_menu_edit"
            android:background="@drawable/shape_circle_gray"
            android:scaleType="center"
            android:elevation="6dp"/>

        <!-- 로그 메일 전송 버튼 -->
        <ImageButton
            android:id="@+id/btnShareLog"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="60dp"
            android:layout_marginBottom="12dp"
            android:src="@android:drawable/ic_menu_send"
            android:background="@drawable/shape_circle_gray"
            android:scaleType="center"
            android:elevation="6dp"/>

        <!-- 목적지 검색 열기 버튼 -->
        <ImageButton
            android:id="@+id/btnOpenSearch"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="12dp"
            android:src="@android:drawable/ic_menu_search"
            android:background="@drawable/shape_circle_gray"
            android:scaleType="center"
            android:elevation="6dp"/>

        <!-- 목적지 검색 패널 -->
        <LinearLayout
            android:id="@+id/llSearchPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="bottom"
            android:background="#EE111111"
            android:padding="12dp"
            android:elevation="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etDestination"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:hint="목적지를 입력하세요 (예: 서울역)"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:background="@drawable/bg_sdi_panel"
                    android:paddingHorizontal="10dp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"
                    android:inputType="text" />

                <Button
                    android:id="@+id/btnSearchGo"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:text="검색"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnSearchClose"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:text="닫기"
                    android:textSize="12sp"
                    android:backgroundTint="#555555" />
            </LinearLayout>

            <ListView
                android:id="@+id/lvSearchResults"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="6dp"
                android:divider="#33FFFFFF"
                android:dividerHeight="1dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvSearchStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textColor="#AAAAAA"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 길안내 중 표시 + 안내 종료 버튼 -->
        <LinearLayout
            android:id="@+id/llGuidanceBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="bottom"
            android:background="#EE1B5E20"
            android:padding="10dp"
            android:elevation="10dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvGuidanceDest"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="길안내 중"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStopGuidance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="안내 종료"
                android:textSize="11sp"
                android:backgroundTint="#F44336" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
