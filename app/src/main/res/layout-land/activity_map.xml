    <!-- v3.1: 사용자 요청 - EVENT/SIGNAL/최근검색을 더보기 목록에서 제거. 이 뷰들을 갱신하는
         내부 로직(카메라 감지, 신호등 상태, 구간단속, 검색이력 저장)은 다른 기능(UDP 전송 등)과
         얽혀있어서 코드까지 들어내면 위험 부담이 커, 화면에 영원히 안 보이는 숨김 컨테이너로
         옮기기만 함 - 기능은 그대로 동작하되 사용자에게는 노출 안 됨. #문제시 원복 -->
    <LinearLayout
        android:id="@+id/llHiddenLegacyPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/llSdiInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSdiDescr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"/>

            <TextView
                android:id="@+id/tvSdiDist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"/>

            <TextView
                android:id="@+id/tvSdiSpeedLimit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""/>

            <LinearLayout
                android:id="@+id/llBlockInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvOffsetTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="구간단속"/>

                <TextView
                    android:id="@+id/tvBlockAvgSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""/>

                <TextView
                    android:id="@+id/tvBlockDist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""/>

                <TextView
                    android:id="@+id/tvBlockTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""/>
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/vTrafficLight"
            android:layout_width="12dp"
            android:layout_height="12dp"/>

        <TextView
            android:id="@+id/tvCarrotVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""/>

        <TextView
            android:id="@+id/tvCarrotIp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IP: -"/>

        <LinearLayout
            android:id="@+id/llRecentSearchPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/llRecentSearchRows"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <TextView
                android:id="@+id/tvRecentSearch1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""/>

            <Button
                android:id="@+id/btnMoreHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ 더보기"/>
        </LinearLayout>
    </LinearLayout>

    <!-- v3.10: 편집모드 확정 체크버튼 - 편집모드 켜지면 더보기 패널이 닫히고 ≡ 버튼도
         비활성화돼서, 편집을 끝낼 방법 자체가 화면에서 사라지는 진짜 버그가 있었음
         (사용자 지적). 항상 화면 위에 뜨는 별도 체크 버튼으로 편집을 끝낼 수 있게 함. #문제시 원복 -->
    <ImageButton
        android:id="@+id/btnConfirmEditPosition"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:src="@drawable/ic_check"
        android:background="@drawable/shape_circle_green"
        android:scaleType="center"
        android:elevation="30dp"
        android:visibility="gone"/>

    <!-- v: 재억 요청(2026-08-25) - 우측 상단 대신 예전 카카오 경유지 버튼 자리(정중앙, 34dp)로
