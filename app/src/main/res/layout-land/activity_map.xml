<?xml version="1.0" encoding="utf-8"?>
<!-- v2.6: 스타일 E - 상단 가로 HUD 바 + 우측(=전체) 지도. 예전 좌측 220dp 세로 패널을
     상단 가로 바로 전환 - 좁고 낮은 차량 헤드유닛(예: 754x354dp)에서 세로 패널 폭이
     너무 좁아져 내용이 잘리던 문제 해결 목적. 자주 쓰는 것(속도/제한/상태/GPS/음소거/검색)만
     상단 바에 상시 노출하고, 나머지(이벤트 상세/신호등/최근검색/설정류)는 "≡" 버튼으로
     열고 닫는 보조 패널(llSecondaryPanel)로 옮김. 뷰 ID는 최대한 그대로 유지해서
     MapActivity.kt 쪽 코드 변경을 최소화함. #문제시 원복 -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080808">

    <!-- ===== 지도 영역: 전체 화면 (SDK 내부 절대좌표 위젯과 좌표계를 맞추기 위함) ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/tmapUILayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- 지도 터치 무력화 -->
        <View
            android:id="@+id/vTouchLockOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#00000000"/>

        <!-- 구간단속 플로팅 패널 (드래그 가능) -->
        <LinearLayout
            android:id="@+id/llOffset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_sdi_panel"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:gravity="center"
            android:elevation="6dp"
            android:visibility="gone"/>

        <!-- 검색 상태 텍스트 패널 - 입력창 자체는 상단바로 이동함(v2.9). #문제시 원복 -->
        <LinearLayout
            android:id="@+id/llSearchPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="bottom"
            android:background="#EE111111"
            android:padding="10dp"
            android:elevation="12dp"
            android:visibility="gone">

            <!-- v2.1부터 검색 결과는 팝업 다이얼로그로 표시해서 이 뷰는 항상 gone 유지됨.
                 코드에서 여전히 참조하므로 삭제하지 않고 남겨둠. #문제시 원복 -->
            <ListView
                android:id="@+id/lvSearchResults"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:divider="#33FFFFFF"
                android:dividerHeight="1dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvSearchStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#AAAAAA"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 길안내 중 표시 + 안내 종료 버튼 -->
        <LinearLayout
            android:id="@+id/llGuidanceBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="bottom"
            android:background="#EE1B5E20"
            android:padding="10dp"
            android:elevation="10dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvGuidanceDest"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="길안내 중"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStopGuidance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="안내 종료"
                android:textSize="11sp"
                android:backgroundTint="#F44336" />
        </LinearLayout>

    </FrameLayout>

    <!-- ===== 카카오내비 오버레이 (검색→길안내 시에만 Tmap 화면 위에 얹힘, 평소엔 GONE) ===== -->
    <FrameLayout
        android:id="@+id/flKakaoOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="50dp"
        android:background="#000000">

        <ViewStub
            android:id="@+id/naviViewStub"
            android:layout="@layout/kakao_navi_view_stub"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/btnStopKakaoGuidance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:text="안내 종료"
            android:backgroundTint="#F44336" />
    </FrameLayout>

    <!-- 차선안내 + 신호등 잔여시간. 상단 바 바로 아래에 뜨도록 marginTop 조정 -->
    <LinearLayout
        android:id="@+id/llLaneSignalBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="76dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#CC000000"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/llLaneBoxes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/tvTrafficLightCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== 상단 HUD 바 (예전 좌측 220dp 세로 패널을 대체) ===== -->
    <LinearLayout
        android:id="@+id/llLeftHudPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:elevation="20dp"
        android:background="#080808">

        <!-- 상시 노출 줄: 속도 / 제한 / 상태 / GPS / 음소거 / 검색 / 메뉴 -->
        <LinearLayout
            android:id="@+id/llTopBarRow"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp">

            <!-- 속도 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/tvCurrentSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="34sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="km/h"
                    android:textColor="#666666"
                    android:textSize="10sp"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvRoadSpeedLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#FF5252"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_speed_limit_hud"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="4dp"/>
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="34dp" android:background="#1A1A1A" android:layout_marginHorizontal="14dp"/>

            <!-- 상태 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="start">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:id="@+id/vConnectionDot"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/shape_circle_gray"
                            android:layout_marginEnd="6dp"/>

                        <TextView
                            android:id="@+id/tvActiveStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OP OFF"
                            android:textColor="#CCCCCC"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvConnectionStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="연결 대기"
                        android:textColor="#777777"
                        android:textSize="9sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="1dp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvXStateBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#4FC3F7"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone"/>
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="34dp" android:background="#1A1A1A" android:layout_marginHorizontal="14dp"/>

            <!-- GPS 상태 -->
            <Button
                android:id="@+id/btnGpsStatus"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="GPS 확인 중"
                android:textSize="9sp"
                android:paddingHorizontal="10dp"
                android:backgroundTint="#111111" />

            <View android:layout_width="1dp" android:layout_height="34dp" android:background="#1A1A1A" android:layout_marginHorizontal="14dp"/>

            <!-- 음소거 / 검색 -->
            <ImageButton
                android:id="@+id/btnMuteToggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:src="@android:drawable/ic_lock_silent_mode"
                android:background="@drawable/shape_circle_gray"
                android:scaleType="center"/>

            <!-- v3.1: 예전엔 이 버튼도 음성검색, 필드 안 마이크도 음성검색이라 완전히
                 중복이었음. 이 버튼을 음성검색 전용(아이콘도 마이크로)으로 통일하고,
                 필드 안 아이콘은 최근검색으로 바꿈. #문제시 원복 -->
            <ImageButton
                android:id="@+id/btnOpenSearch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:src="@android:drawable/ic_btn_speak_now"
                android:tint="#FFFFFF"
                android:background="@drawable/shape_circle_gray"
                android:scaleType="center"/>

            <!-- v2.9: 검색 팝업을 거치지 않고 상단바에서 바로 입력 가능하도록 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_sdi_panel"
                android:paddingHorizontal="10dp">

                <EditText
                    android:id="@+id/etDestination"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="목적지를 입력하세요"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666666"
                    android:textSize="12sp"
                    android:background="@android:color/transparent"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"
                    android:inputType="text" />

                <!-- v3.1: 마이크(음성검색, 왼쪽 버튼과 중복)에서 최근검색으로 변경 -->
                <ImageButton
                    android:id="@+id/btnVoiceSearch"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="4dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    android:background="@android:color/transparent"
                    android:scaleType="center" />
            </LinearLayout>

            <!-- 도착정보 (안내 중일 때만) -->
            <TextView
                android:id="@+id/tvTopBarEta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#CCCCCC"
                android:textSize="11sp"
                android:gravity="end"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:visibility="gone"/>

            <!-- 메뉴 (나머지 항목: 이벤트/신호등/최근검색/설정 등) -->
            <ImageButton
                android:id="@+id/btnMoreMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_more"
                android:background="@drawable/shape_circle_gray"
                android:scaleType="center"/>
        </LinearLayout>
    </LinearLayout>

    <!-- v3.0: 보조 패널을 llLeftHudPanel 밖으로 분리해서 지도 위에 뜨는 독립 오버레이로
         만듦 - 예전엔 llLeftHudPanel 안에 있어서 펼쳐지면 상단바 전체 높이가 커져서
         드래그 편집 가능 범위가 줄어드는 문제가 있었음(사용자 지적 2번). 이제 llLeftHudPanel은
         항상 72dp 고정이라 편집모드에서도 화면 어디든 자유롭게 옮길 수 있음. #문제시 원복 -->
    <ScrollView
        android:id="@+id/svSecondaryPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="76dp"
        android:layout_marginEnd="4dp"
        android:visibility="gone"
        android:background="#0D0D0D"
        android:elevation="22dp"
        android:overScrollMode="never"
        android:maxHeight="420dp">

        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <ImageButton
                android:id="@+id/btnShareLog"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_send"
                android:background="@drawable/shape_circle_gray"
                android:scaleType="center"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnEditPanelPosition"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="패널 위치 편집"
                android:textSize="13sp"
                android:padding="0dp"
                android:backgroundTint="#111111"
                android:textColor="#888888"
                android:layout_marginBottom="6dp"/>

            <Button
                android:id="@+id/btnEditKey"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="설정"
                android:textSize="13sp"
                android:padding="0dp"
                android:backgroundTint="#111111"
                android:textColor="#888888"
                android:layout_marginBottom="6dp"/>

            <Button
                android:id="@+id/btnCheckUpdate"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="업데이트 확인"
                android:textSize="13sp"
                android:padding="0dp"
                android:backgroundTint="#111111"
                android:textColor="#888888"
                android:layout_marginBottom="6dp"/>

            <Button
                android:id="@+id/btnExitApp"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="앱 종료"
                android:textSize="13sp"
                android:padding="0dp"
                android:backgroundTint="#1A0000"
                android:textColor="#EF5350"/>

            <TextView
                android:id="@+id/tvAppVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#333333"
                android:textSize="9sp"
                android:layout_marginTop="8dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- v3.1: 사용자 요청 - EVENT/SIGNAL/최근검색을 더보기 목록에서 제거. 이 뷰들을 갱신하는
         내부 로직(카메라 감지, 신호등 상태, 구간단속, 검색이력 저장)은 다른 기능(UDP 전송 등)과
         얽혀있어서 코드까지 들어내면 위험 부담이 커, 화면에 영원히 안 보이는 숨김 컨테이너로
         옮기기만 함 - 기능은 그대로 동작하되 사용자에게는 노출 안 됨. #문제시 원복 -->
    <LinearLayout
        android:id="@+id/llHiddenLegacyPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/llSdiInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSdiDescr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"/>

            <TextView
                android:id="@+id/tvSdiDist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"/>

            <TextView
                android:id="@+id/tvSdiSpeedLimit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""/>

            <LinearLayout
                android:id="@+id/llBlockInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvOffsetTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="구간단속"/>

                <TextView
                    android:id="@+id/tvBlockAvgSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""/>

                <TextView
                    android:id="@+id/tvBlockDist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""/>

                <TextView
                    android:id="@+id/tvBlockTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""/>
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/vTrafficLight"
            android:layout_width="12dp"
            android:layout_height="12dp"/>

        <TextView
            android:id="@+id/tvCarrotVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""/>

        <TextView
            android:id="@+id/tvCarrotIp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IP: -"/>

        <LinearLayout
            android:id="@+id/llRecentSearchPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/llRecentSearchRows"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <TextView
                android:id="@+id/tvRecentSearch1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""/>

            <Button
                android:id="@+id/btnMoreHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ 더보기"/>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
