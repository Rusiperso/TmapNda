<?xml version="1.0" encoding="utf-8"?>
<!-- v2.6: 스타일 E - 상단 가로 HUD 바 + 우측(=전체) 지도. 예전 좌측 220dp 세로 패널을
     상단 가로 바로 전환 - 좁고 낮은 차량 헤드유닛(예: 754x354dp)에서 세로 패널 폭이
     너무 좁아져 내용이 잘리던 문제 해결 목적. 자주 쓰는 것(속도/제한/상태/GPS/음소거/검색)만
     상단 바에 상시 노출하고, 나머지(이벤트 상세/신호등/최근검색/설정류)는 "≡" 버튼으로
     열고 닫는 보조 패널(llSecondaryPanel)로 옮김. 뷰 ID는 최대한 그대로 유지해서
     MapActivity.kt 쪽 코드 변경을 최소화함. #문제시 원복 -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080808">

    <!-- ===== 지도 영역: 전체 화면 (SDK 내부 절대좌표 위젯과 좌표계를 맞추기 위함) ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/tmapUILayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- 지도 터치 무력화 -->
        <View
            android:id="@+id/vTouchLockOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#00000000"/>

        <!-- 구간단속 플로팅 패널 (드래그 가능) -->
        <LinearLayout
            android:id="@+id/llOffset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_sdi_panel"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:gravity="center"
            android:elevation="6dp"
            android:visibility="gone"/>

        <!-- 목적지 검색 패널 - 상단 바 아래로 (marginStart 220dp -> marginTop 72dp) -->
        <LinearLayout
            android:id="@+id/llSearchPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="bottom"
            android:background="#EE111111"
            android:padding="12dp"
            android:elevation="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etDestination"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:hint="목적지를 입력하세요 (예: 서울역)"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:background="@drawable/bg_sdi_panel"
                    android:paddingHorizontal="10dp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"
                    android:inputType="text" />

                <ImageButton
                    android:id="@+id/btnVoiceSearch"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:src="@android:drawable/ic_btn_speak_now"
                    android:background="@drawable/shape_circle_gray"
                    android:scaleType="center" />

                <Button
                    android:id="@+id/btnSearchGo"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:text="검색"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnSearchClose"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:text="닫기"
                    android:textSize="12sp"
                    android:backgroundTint="#555555" />
            </LinearLayout>

            <!-- v2.1부터 검색 결과는 팝업 다이얼로그로 표시해서 이 뷰는 항상 gone 유지됨.
                 코드에서 여전히 참조하므로 삭제하지 않고 남겨둠. #문제시 원복 -->
            <ListView
                android:id="@+id/lvSearchResults"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="6dp"
                android:divider="#33FFFFFF"
                android:dividerHeight="1dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvSearchStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textColor="#AAAAAA"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 길안내 중 표시 + 안내 종료 버튼 -->
        <LinearLayout
            android:id="@+id/llGuidanceBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="bottom"
            android:background="#EE1B5E20"
            android:padding="10dp"
            android:elevation="10dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvGuidanceDest"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="길안내 중"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStopGuidance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="안내 종료"
                android:textSize="11sp"
                android:backgroundTint="#F44336" />
        </LinearLayout>

    </FrameLayout>

    <!-- ===== 카카오내비 오버레이 (검색→길안내 시에만 Tmap 화면 위에 얹힘, 평소엔 GONE) ===== -->
    <FrameLayout
        android:id="@+id/flKakaoOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="50dp"
        android:background="#000000">

        <ViewStub
            android:id="@+id/naviViewStub"
            android:layout="@layout/kakao_navi_view_stub"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/btnStopKakaoGuidance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:text="안내 종료"
            android:backgroundTint="#F44336" />
    </FrameLayout>

    <!-- 차선안내 + 신호등 잔여시간. 상단 바 바로 아래에 뜨도록 marginTop 조정 -->
    <LinearLayout
        android:id="@+id/llLaneSignalBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="76dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#CC000000"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/llLaneBoxes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/tvTrafficLightCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== 상단 HUD 바 (예전 좌측 220dp 세로 패널을 대체) ===== -->
    <LinearLayout
        android:id="@+id/llLeftHudPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:elevation="20dp"
        android:background="#080808">

        <!-- 상시 노출 줄: 속도 / 제한 / 상태 / GPS / 음소거 / 검색 / 메뉴 -->
        <LinearLayout
            android:id="@+id/llTopBarRow"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp">

            <!-- 속도 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/tvCurrentSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="34sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="km/h"
                    android:textColor="#666666"
                    android:textSize="10sp"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvRoadSpeedLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#FF5252"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_speed_limit_hud"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="4dp"/>
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="34dp" android:background="#1A1A1A" android:layout_marginHorizontal="14dp"/>

            <!-- 상태 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvActiveStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OP OFF"
                        android:textColor="#AAAAAA"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <View
                        android:id="@+id/vConnectionDot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/shape_circle_gray"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="4dp"/>

                    <TextView
                        android:id="@+id/tvConnectionStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="연결 대기"
                        android:textColor="#777777"
                        android:textSize="9sp"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvXStateBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#4FC3F7"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone"/>
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="34dp" android:background="#1A1A1A" android:layout_marginHorizontal="14dp"/>

            <!-- GPS 상태 -->
            <Button
                android:id="@+id/btnGpsStatus"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="GPS 확인 중"
                android:textSize="9sp"
                android:paddingHorizontal="10dp"
                android:backgroundTint="#111111" />

            <View android:layout_width="1dp" android:layout_height="34dp" android:background="#1A1A1A" android:layout_marginHorizontal="14dp"/>

            <!-- 음소거 / 검색 -->
            <ImageButton
                android:id="@+id/btnMuteToggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:src="@android:drawable/ic_lock_silent_mode"
                android:background="@drawable/shape_circle_gray"
                android:scaleType="center"/>

            <ImageButton
                android:id="@+id/btnOpenSearch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_search"
                android:background="@drawable/shape_circle_gray"
                android:scaleType="center"/>

            <!-- spacer -->
            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

            <!-- 도착정보 (안내 중일 때만) -->
            <TextView
                android:id="@+id/tvTopBarEta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#CCCCCC"
                android:textSize="11sp"
                android:gravity="end"
                android:layout_marginEnd="10dp"
                android:visibility="gone"/>

            <!-- 메뉴 (나머지 항목: 이벤트/신호등/최근검색/설정 등) -->
            <ImageButton
                android:id="@+id/btnMoreMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_more"
                android:background="@drawable/shape_circle_gray"
                android:scaleType="center"/>
        </LinearLayout>

        <!-- 보조 패널: btnMoreMenu 탭하면 열림/닫힘. 이벤트/신호등/최근검색/설정류를 여기로 이동. -->
        <ScrollView
            android:id="@+id/svSecondaryPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:visibility="gone"
            android:background="#0D0D0D"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- 카메라/방지턱 이벤트 -->
                <LinearLayout
                    android:id="@+id/llSdiInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EVENT"
                        android:textColor="#444444"
                        android:textSize="9sp"
                        android:letterSpacing="0.15"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvSdiDescr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="#FFC107"
                        android:textSize="11sp"
                        android:layout_marginBottom="2dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom">

                        <TextView
                            android:id="@+id/tvSdiDist"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:maxLines="1"/>

                        <TextView
                            android:id="@+id/tvSdiSpeedLimit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#FF5252"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginStart="6dp"
                            android:layout_marginBottom="4dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llBlockInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="4dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvOffsetTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="구간단속"
                            android:textColor="#FFC107"
                            android:textSize="10sp"
                            android:visibility="gone"/>

                        <TextView
                            android:id="@+id/tvBlockAvgSpeed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvBlockDist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#AAAAAA"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/tvBlockTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#AAAAAA"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A1A1A" android:layout_marginBottom="10dp"/>

                <!-- 신호등 / 카로트버전 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <View
                        android:id="@+id/vTrafficLight"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/shape_circle_gray"
                        android:layout_marginEnd="8dp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SIGNAL"
                            android:textColor="#444444"
                            android:textSize="8sp"/>

                        <TextView
                            android:id="@+id/tvCarrotVersion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#666666"
                            android:textSize="9sp"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCarrotIp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IP: -"
                    android:textColor="#444444"
                    android:textSize="9sp"
                    android:maxLines="1"
                    android:ellipsize="middle"
                    android:layout_marginBottom="10dp"/>

                <ImageButton
                    android:id="@+id/btnShareLog"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_send"
                    android:background="@drawable/shape_circle_gray"
                    android:scaleType="center"
                    android:layout_marginBottom="10dp"/>

                <!-- 최근 검색 이력 -->
                <LinearLayout
                    android:id="@+id/llRecentSearchPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="최근 검색"
                        android:textColor="#666666"
                        android:textSize="9sp"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="4dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#141414">

                        <TextView
                            android:id="@+id/tvRecentSearch1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="9dp"
                            android:textColor="#DDDDDD"
                            android:textSize="12sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnMoreHistory"
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:layout_marginTop="4dp"
                        android:text="+ 더보기"
                        android:textSize="11sp"
                        android:textColor="#888888"
                        android:background="@drawable/shape_circle_gray"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnEditKey"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="설정"
                    android:textSize="13sp"
                    android:padding="0dp"
                    android:backgroundTint="#111111"
                    android:textColor="#888888"
                    android:layout_marginBottom="6dp"/>

                <Button
                    android:id="@+id/btnCheckUpdate"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="업데이트 확인"
                    android:textSize="13sp"
                    android:padding="0dp"
                    android:backgroundTint="#111111"
                    android:textColor="#888888"
                    android:layout_marginBottom="6dp"/>

                <Button
                    android:id="@+id/btnExitApp"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="앱 종료"
                    android:textSize="13sp"
                    android:padding="0dp"
                    android:backgroundTint="#1A0000"
                    android:textColor="#EF5350"/>

                <TextView
                    android:id="@+id/tvAppVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#333333"
                    android:textSize="9sp"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</FrameLayout>
