<?xml version="1.0" encoding="utf-8"?>
<!-- v3.0: Tmap HUD 화면(activity_map.xml)과 완전히 동일한 상단바+≡메뉴 패턴으로 통일.
     그동안 예전 좌측 220dp 세로 패널 스타일이 그대로 남아있어서 Tmap 화면과 다르게
     보이는 문제(재억 지적 4번: "카카오 길안내 시 구버전 UI화면 나옴") 해결.
     Tmap 전용 버튼(음소거는 카카오 자체 음소거, 설정/업데이트/앱종료는 제외)만
     빼고 뷰 ID는 최대한 동일하게 맞춤. #문제시 원복 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080808">

    <com.kakaomobility.knsdk.ui.view.KNNaviView
        android:id="@+id/naviView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <Button
        android:id="@+id/btnStopKakaoGuidance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:text="안내 종료"
        android:backgroundTint="#F44336"
        android:elevation="22dp" />

    <!-- 차선안내/신호등 잔여시간 - 상단바 아래로 -->
    <LinearLayout
        android:id="@+id/llLaneSignalBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="76dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#CC000000"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/llLaneBoxes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/tvTrafficLightCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== 상단 HUD 바 (Tmap 화면과 동일 패턴) ===== -->
    <LinearLayout
        android:id="@+id/llLeftHudPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:elevation="20dp"
        android:background="#080808">

        <LinearLayout
            android:id="@+id/llTopBarRow"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/tvCurrentSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="34sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="km/h"
                    android:textColor="#666666"
                    android:textSize="10sp"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvRoadSpeedLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#FF5252"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_speed_limit_hud"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="4dp"/>
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="34dp" android:background="#1A1A1A" android:layout_marginHorizontal="14dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/vConnectionDot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/shape_circle_gray"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/tvActiveStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OP OFF"
                        android:textColor="#CCCCCC"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvConnectionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="연결 대기"
                    android:textColor="#777777"
                    android:textSize="9sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="1dp"/>
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="34dp" android:background="#1A1A1A" android:layout_marginHorizontal="14dp"/>

            <Button
                android:id="@+id/btnGpsStatus"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="GPS 확인 중"
                android:textSize="9sp"
                android:paddingHorizontal="10dp"
                android:backgroundTint="#111111" />

            <View android:layout_width="1dp" android:layout_height="34dp" android:background="#1A1A1A" android:layout_marginHorizontal="14dp"/>

            <ImageButton
                android:id="@+id/btnKakaoMuteToggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                android:background="@drawable/shape_circle_green"
                android:scaleType="center"/>

            <ImageButton
                android:id="@+id/btnOpenSearch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_search"
                android:background="@drawable/shape_circle_gray"
                android:scaleType="center"/>

            <!-- spacer -->
            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

            <ImageButton
                android:id="@+id/btnMoreMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_more"
                android:background="@drawable/shape_circle_gray"
                android:scaleType="center"/>
        </LinearLayout>
    </LinearLayout>

    <!-- v3.0: 보조 패널을 llLeftHudPanel 밖으로 분리 (Tmap 화면과 동일 이유) -->
    <ScrollView
        android:id="@+id/svSecondaryPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="76dp"
        android:layout_marginEnd="4dp"
        android:visibility="gone"
        android:background="#0D0D0D"
        android:elevation="22dp"
        android:overScrollMode="never"
        android:maxHeight="420dp">

        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:id="@+id/llSdiInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EVENT"
                        android:textColor="#444444"
                        android:textSize="9sp"
                        android:letterSpacing="0.15"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvSdiDescr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="#FFC107"
                        android:textSize="11sp"
                        android:layout_marginBottom="2dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom">

                        <TextView
                            android:id="@+id/tvSdiDist"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:maxLines="1"/>

                        <TextView
                            android:id="@+id/tvSdiSpeedLimit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#FF5252"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginStart="6dp"
                            android:layout_marginBottom="4dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llBlockInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="4dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvBlockAvgSpeed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvBlockDist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#AAAAAA"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/tvBlockTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#AAAAAA"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A1A1A" android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <View
                        android:id="@+id/vTrafficLight"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/shape_circle_gray"
                        android:layout_marginEnd="8dp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SIGNAL"
                            android:textColor="#444444"
                            android:textSize="8sp"/>

                        <TextView
                            android:id="@+id/tvCarrotVersion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#666666"
                            android:textSize="9sp"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCarrotIp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IP: -"
                    android:textColor="#444444"
                    android:textSize="9sp"
                    android:maxLines="1"
                    android:ellipsize="middle"
                    android:layout_marginBottom="10dp"/>

                <ImageButton
                    android:id="@+id/btnShareLog"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_send"
                    android:background="@drawable/shape_circle_gray"
                    android:scaleType="center"
                    android:layout_marginBottom="10dp"/>

                <!-- 최근 목적지 5개 + 더보기 (Tmap과 동일한 저장소를 그대로 읽음) -->
                <LinearLayout
                    android:id="@+id/llRecentSearchPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="최근 목적지"
                        android:textColor="#666666"
                        android:textSize="9sp"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="4dp"/>

                    <LinearLayout
                        android:id="@+id/llRecentSearchRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#141414" />

                    <Button
                        android:id="@+id/btnMoreHistory"
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:layout_marginTop="4dp"
                        android:text="+ 더보기"
                        android:textSize="11sp"
                        android:textColor="#888888"
                        android:background="@drawable/shape_circle_gray"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAppVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#333333"
                    android:textSize="9sp"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>
        </ScrollView>

</FrameLayout>
