<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TmapNda 설정"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="32dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tmap App Key"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAppKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"/>

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="카카오 REST API 키 (목적지 검색용, 선택)"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etKakaoAppKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"/>

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="카카오 네이티브 앱 키 (길안내용, 선택 - 카카오 콘솔 각자 발급)"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etKakaoNativeAppKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- v: 신규기능(주유소 브랜드/유가 검색) - 오피넷 API도 각자 발급받아 넣는 방식(재억
         지적: 한 명 키를 공유하면 하루 1500건 한도가 금방 소진됨). #문제시 원복 -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="오피넷 API 키 (주유소 유가정보용, 선택 - opinet.co.kr 각자 발급)"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etOpinetApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- v: 신규기능(전기차 충전소) - 한국환경공단 API도 각자 발급받아 넣는 방식(공공데이터포털). #문제시 원복 -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="전기차 충전소 API 키 (선택 - data.go.kr 각자 발급)"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEvChargerApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"/>

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="UDP Target IP (기본: 255.255.255.255)"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTargetIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:text="255.255.255.255"/>

    </com.google.android.material.textfield.TextInputLayout>

    <CheckBox
        android:id="@+id/cbBackgroundLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="항상 허용 (백그라운드 동작 허용)"
        android:layout_marginBottom="16dp"/>

    <CheckBox
        android:id="@+id/cbNavdyConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Navdy 연결 (블루투스 권한 허용)"
        android:layout_marginBottom="16dp"/>

    <CheckBox
        android:id="@+id/cbBackgroundOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="다른 앱 위에 표시 (백그라운드 방향 안내, 실험적 기능)"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvAppVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="버전: -"
        android:textColor="#888888"
        android:textSize="12sp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"/>

    </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/btnStartNavi"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_margin="24dp"
        android:layout_marginTop="8dp"
        android:text="안전운행 시작하기"
        android:textSize="18sp"/>

</LinearLayout>
