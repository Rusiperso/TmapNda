<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#222222">

    <!-- 상단 통합 UI 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="#222222">

        <!-- 연결 상태 (왼쪽) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:background="@drawable/bg_sdi_panel"
            android:padding="12dp">


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">
                <View
                    android:id="@+id/vConnectionDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/shape_circle_gray"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:id="@+id/tvConnectionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OP 연결 대기"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnGpsStatus"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="GPS 확인 중"
                android:textSize="10sp"
                android:paddingHorizontal="10dp"
                android:backgroundTint="#555555"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvCarrotVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ver: -"
                    android:textColor="#AAAAAA"
                    android:textSize="10sp"
                    android:layout_marginBottom="2dp" />
                <TextView
                    android:id="@+id/tvCarrotIp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IP: -"
                    android:textColor="#888888"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 버튼 그룹 (오른쪽) -->
        <LinearLayout
            android:id="@+id/llButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tvAppVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v-"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <Button
                android:id="@+id/btnCheckUpdate"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="업데이트 확인"
                android:textSize="10sp"
                android:paddingHorizontal="10dp"
                android:layout_marginBottom="4dp"
                android:layout_gravity="end" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnEditKey"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="설정"
                    android:textSize="12sp"
                    android:paddingHorizontal="12dp"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnExitApp"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="앱 종료"
                    android:textSize="12sp"
                    android:paddingHorizontal="12dp"
                    android:backgroundTint="#F44336" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 하단 지도 영역 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        
        <FrameLayout
            android:id="@+id/tmapUILayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Tmap 지도 터치 무력화: 항상 터치를 가로채서 하위 NavigationFragment(지도)로 전달 안 함. -->
        <View
            android:id="@+id/vTouchLockOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#00000000" />

        <!-- 주행 정보 오버레이 통합 대시보드 (2x2 배열) -->
        <LinearLayout
            android:id="@+id/llRoadInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_sdi_panel"
            android:layout_margin="16dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:layout_gravity="top|start"
            android:elevation="6dp">

            <!-- 첫 번째 줄 (제한속도, 단속카메라) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- 1. 현재 도로 제한속도 -->
                <LinearLayout
                    android:id="@+id/llRoadSpeedLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:background="@drawable/bg_us_speed_limit"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SPEED"
                        android:textColor="#000000"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LIMIT"
                        android:textColor="#000000"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRoadSpeedLimit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="#000000"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#33FFFFFF"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginVertical="4dp"/>

                <!-- 2. 과속 카메라 (SDI 이벤트) -->
                <LinearLayout
                    android:id="@+id/llSdiEvent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_speed_limit"/>
                        <TextView
                            android:id="@+id/tvEventSpeedLimit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="60"
                            android:textColor="#000000"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvEventDist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="300m"
                        android:textColor="#FFEB3B"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:id="@+id/tvEventType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="단속"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 가로 구분선 -->
            <View
                android:id="@+id/vDividerSdi"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33FFFFFF"
                android:layout_marginVertical="12dp"/>

            <!-- 두 번째 줄 (OP 상태) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- 4. Openpilot 상태 패널 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <!-- tvCurrentSpeed: 가로모드(HUD) 전용, 세로모드에선 숨김 -->
                    <TextView
                        android:id="@+id/tvCurrentSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:visibility="gone"/>

                    <!-- 가로모드 HUD 전용 뷰들 (세로모드에서는 숨김) -->
                    <LinearLayout
                        android:id="@+id/llSdiInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">
                        <TextView android:id="@+id/tvSdiDescr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:visibility="gone"/>
                        <TextView android:id="@+id/tvSdiDist" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:visibility="gone"/>
                        <TextView android:id="@+id/tvSdiSpeedLimit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:visibility="gone"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvActiveStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OP OFF"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/bg_status_off"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="신호:"
                            android:textColor="#AAAAAA"
                            android:textSize="10sp" />
                        <View
                            android:id="@+id/vTrafficLight"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/shape_circle_gray"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvXStateBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CRUISE"
                        android:textColor="#2196F3"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>


        <!-- 지도 터치 방지용 투명 오버레이 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true" />

        <!-- 구간단속 평균속도 정보 패널 -->
        <LinearLayout
            android:id="@+id/llOffset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="top|end"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_sdi_panel"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:gravity="center"
            android:elevation="6dp">

            <TextView
                android:id="@+id/tvOffsetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="구간단속"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"/>

                <!-- 구간단속 정보 -->
                <LinearLayout
                    android:id="@+id/llBlockInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:visibility="gone">
                    
                    <TextView
                        android:id="@+id/tvBlockAvgSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="평균: 0km/h"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                        
                    <TextView
                        android:id="@+id/tvBlockDist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="거리: 0m"
                        android:textColor="#EEEEEE"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp" />
                        
                    <TextView
                        android:id="@+id/tvBlockTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="시간: 0:00"
                        android:textColor="#EEEEEE"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
        </LinearLayout>

        <!-- 오버레이 편집 모드 버튼 (그래픽) -->
        <ImageButton
            android:id="@+id/btnEditMode"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="32dp"
            android:src="@android:drawable/ic_menu_edit"
            android:background="@drawable/shape_circle_gray"
            android:scaleType="center"
            android:elevation="6dp" />
    </FrameLayout>

</LinearLayout>
