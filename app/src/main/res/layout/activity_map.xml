<?xml version="1.0" encoding="utf-8"?>
<!-- v2.7: 세로모드도 가로모드와 같은 패턴으로 통일. 상시 노출(속도/제한/상태/GPS/음소거/
     검색/메뉴)은 상단 바에, 나머지(이벤트 상세/신호등/최근검색/설정류)는 btnMoreMenu(≡)로
     열고 닫는 svSecondaryPanel로. 뷰 ID는 가로모드와 동일하게 맞춰서 코드 공용 사용. #문제시 원복 -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080808">

    <FrameLayout
        android:id="@+id/tmapUILayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/vTouchLockOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00000000" />

    <!-- 구간단속 플로팅 카드 -->
    <LinearLayout
        android:id="@+id/llOffset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="top|end"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_sdi_panel"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:gravity="center"
        android:elevation="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvOffsetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="구간단속"
            android:textColor="#FFC107"
            android:textSize="11sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:id="@+id/llBlockInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvBlockAvgSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="평균: 0km/h"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBlockDist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="거리: 0m"
                android:textColor="#AAAAAA"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tvBlockTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="시간: 0:00"
                android:textColor="#AAAAAA"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 목적지 검색 패널 -->
    <LinearLayout
        android:id="@+id/llSearchPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom"
        android:background="#EE111111"
        android:padding="12dp"
        android:elevation="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etDestination"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:hint="목적지를 입력하세요 (예: 서울역)"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:background="@drawable/bg_sdi_panel"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text" />

            <ImageButton
                android:id="@+id/btnVoiceSearch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:src="@android:drawable/ic_btn_speak_now"
                android:background="@drawable/shape_circle_gray"
                android:scaleType="center" />

            <Button
                android:id="@+id/btnSearchGo"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:text="검색"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSearchClose"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:text="닫기"
                android:textSize="12sp"
                android:backgroundTint="#555555" />
        </LinearLayout>

        <ListView
            android:id="@+id/lvSearchResults"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:divider="#33FFFFFF"
            android:dividerHeight="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvSearchStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="#AAAAAA"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 길안내 중 표시 + 안내 종료 버튼 -->
    <LinearLayout
        android:id="@+id/llGuidanceBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="bottom"
        android:background="#EE1B5E20"
        android:padding="10dp"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvGuidanceDest"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="길안내 중"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnStopGuidance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="안내 종료"
            android:textSize="11sp"
            android:backgroundTint="#F44336" />
    </LinearLayout>

    <!-- ===== 카카오내비 오버레이 ===== -->
    <FrameLayout
        android:id="@+id/flKakaoOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="50dp"
        android:background="#000000">

        <ViewStub
            android:id="@+id/naviViewStub"
            android:layout="@layout/kakao_navi_view_stub"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/btnStopKakaoGuidance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:text="안내 종료"
            android:backgroundTint="#F44336" />
    </FrameLayout>

    <!-- ===== 상단 HUD 바 (가로모드와 동일한 패턴) ===== -->
    <LinearLayout
        android:id="@+id/llTopHudBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:elevation="20dp"
        android:background="#FF080808">

        <LinearLayout
            android:id="@+id/llTopBarRow"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <!-- 속도 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/tvCurrentSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRoadSpeedLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#FF5252"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_speed_limit_hud"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="4dp"/>
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="28dp" android:background="#1A1A1A" android:layout_marginHorizontal="10dp"/>

            <!-- 상태 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/vConnectionDot"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/shape_circle_gray"
                        android:layout_marginEnd="5dp"/>

                    <TextView
                        android:id="@+id/tvActiveStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OP OFF"
                        android:textColor="#CCCCCC"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvConnectionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="연결 대기"
                    android:textColor="#777777"
                    android:textSize="8sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="1dp"/>
            </LinearLayout>

            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

            <Button
                android:id="@+id/btnGpsStatus"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="GPS"
                android:textSize="9sp"
                android:paddingHorizontal="8dp"
                android:backgroundTint="#111111"
                android:layout_marginEnd="8dp"/>

            <ImageButton
                android:id="@+id/btnMuteToggle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:src="@android:drawable/ic_lock_silent_mode"
                android:background="@drawable/shape_circle_gray"
                android:scaleType="center"/>

            <ImageButton
                android:id="@+id/btnOpenSearch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:src="@android:drawable/ic_menu_search"
                android:background="@drawable/shape_circle_gray"
                android:scaleType="center"/>

            <ImageButton
                android:id="@+id/btnMoreMenu"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_more"
                android:background="@drawable/shape_circle_gray"
                android:scaleType="center"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvTopBarEta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#CCCCCC"
            android:textSize="11sp"
            android:paddingHorizontal="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone"/>

        <!-- 보조 패널: btnMoreMenu 탭하면 열림/닫힘 -->
        <ScrollView
            android:id="@+id/svSecondaryPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:visibility="gone"
            android:background="#0D0D0D"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:id="@+id/llSdiInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EVENT"
                        android:textColor="#444444"
                        android:textSize="9sp"
                        android:letterSpacing="0.15"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvSdiDescr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="#FFC107"
                        android:textSize="11sp"
                        android:layout_marginBottom="2dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom">

                        <TextView
                            android:id="@+id/tvSdiDist"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:maxLines="1"/>

                        <TextView
                            android:id="@+id/tvSdiSpeedLimit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#FF5252"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginStart="6dp"
                            android:layout_marginBottom="4dp"/>
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A1A1A" android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <View
                        android:id="@+id/vTrafficLight"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/shape_circle_gray"
                        android:layout_marginEnd="8dp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SIGNAL"
                            android:textColor="#444444"
                            android:textSize="8sp"/>

                        <TextView
                            android:id="@+id/tvCarrotVersion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#666666"
                            android:textSize="9sp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvXStateBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#4FC3F7"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCarrotIp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IP: -"
                    android:textColor="#444444"
                    android:textSize="9sp"
                    android:maxLines="1"
                    android:ellipsize="middle"
                    android:layout_marginBottom="10dp"/>

                <ImageButton
                    android:id="@+id/btnShareLog"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_send"
                    android:background="@drawable/shape_circle_gray"
                    android:scaleType="center"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:id="@+id/llRecentSearchPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="최근 검색"
                        android:textColor="#666666"
                        android:textSize="9sp"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="4dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#141414">

                        <TextView
                            android:id="@+id/tvRecentSearch1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="9dp"
                            android:textColor="#DDDDDD"
                            android:textSize="12sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnMoreHistory"
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:layout_marginTop="4dp"
                        android:text="+ 더보기"
                        android:textSize="11sp"
                        android:textColor="#888888"
                        android:background="@drawable/shape_circle_gray"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnEditPanelPosition"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="패널 위치 편집"
                    android:textSize="13sp"
                    android:padding="0dp"
                    android:backgroundTint="#111111"
                    android:textColor="#888888"
                    android:layout_marginBottom="6dp"/>

                <Button
                    android:id="@+id/btnEditKey"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="설정"
                    android:textSize="13sp"
                    android:padding="0dp"
                    android:backgroundTint="#111111"
                    android:textColor="#888888"
                    android:layout_marginBottom="6dp"/>

                <Button
                    android:id="@+id/btnCheckUpdate"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="업데이트 확인"
                    android:textSize="13sp"
                    android:padding="0dp"
                    android:backgroundTint="#111111"
                    android:textColor="#888888"
                    android:layout_marginBottom="6dp"/>

                <Button
                    android:id="@+id/btnExitApp"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="앱 종료"
                    android:textSize="13sp"
                    android:padding="0dp"
                    android:backgroundTint="#1A0000"
                    android:textColor="#EF5350"/>

                <TextView
                    android:id="@+id/tvAppVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#333333"
                    android:textSize="9sp"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</FrameLayout>
