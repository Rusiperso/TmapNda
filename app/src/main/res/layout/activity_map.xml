<?xml version="1.0" encoding="utf-8"?>
<!-- v2.7: 세로모드도 가로모드와 같은 패턴으로 통일. 상시 노출(속도/제한/상태/GPS/음소거/
     검색/메뉴)은 상단 바에, 나머지(이벤트 상세/신호등/최근검색/설정류)는 btnMoreMenu(≡)로
     열고 닫는 svSecondaryPanel로. 뷰 ID는 가로모드와 동일하게 맞춰서 코드 공용 사용. #문제시 원복 -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080808">

    <FrameLayout
        android:id="@+id/tmapUILayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/vTouchLockOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00000000" />

    <!-- 구간단속 플로팅 카드 -->
    <LinearLayout
        android:id="@+id/llOffset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="top|end"
        android:layout_marginTop="52dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_sdi_panel"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:gravity="center"
        android:elevation="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvOffsetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="구간단속"
            android:textColor="#FFC107"
            android:textSize="11sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:id="@+id/llBlockInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvBlockAvgSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="평균: 0km/h"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBlockDist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="거리: 0m"
                android:textColor="#AAAAAA"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tvBlockTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="시간: 0:00"
                android:textColor="#AAAAAA"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 목적지 검색 패널 -->
    <LinearLayout
        android:id="@+id/llSearchPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom"
        android:background="#EE111111"
        android:padding="12dp"
        android:elevation="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etDestination"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:hint="목적지 검색"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:background="@drawable/bg_sdi_panel"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text" />

            <ImageButton
                android:id="@+id/btnVoiceSearch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_mic"
                android:background="@drawable/shape_circle_gray"
                android:scaleType="center" />

            <Button
                android:id="@+id/btnSearchGo"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:text="검색"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSearchClose"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:text="닫기"
                android:textSize="12sp"
                android:backgroundTint="#555555" />
        </LinearLayout>

        <ListView
            android:id="@+id/lvSearchResults"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:divider="#33FFFFFF"
            android:dividerHeight="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvSearchStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="#AAAAAA"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 길안내 중 표시 + 안내 종료 버튼 -->
    <LinearLayout
        android:id="@+id/llGuidanceBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="bottom"
        android:background="#EE1B5E20"
        android:padding="10dp"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvGuidanceDest"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="길안내 중"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnStopGuidance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="안내 종료"
            android:textSize="11sp"
            android:backgroundTint="#F44336" />
    </LinearLayout>

    <!-- v5.4: 세로모드 티맵 화면에 차선안내+신호등 바가 아예 없었음(사용자 요청 - 차선
         오버레이 제대로 만들기 - 확인 중 발견) - 가로모드/카카오 화면과 동일하게 추가. #문제시 원복 -->
    <LinearLayout
        android:id="@+id/llLaneSignalBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#CC000000"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/llLaneBoxes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/tvTrafficLightCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== 카카오내비 오버레이 ===== -->
    <FrameLayout
        android:id="@+id/flKakaoOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="50dp"
        android:background="@android:color/transparent">

        <ViewStub
            android:id="@+id/naviViewStub"
            android:layout="@layout/kakao_navi_view_stub"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/btnStopKakaoGuidance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:text="안내 종료"
            android:backgroundTint="#F44336" />
    </FrameLayout>

    <!-- ===== 상단 HUD 바 (가로모드와 동일한 패턴) ===== -->
    <LinearLayout
        android:id="@+id/llLeftHudPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:elevation="20dp"
        android:background="#FF080808">

        <!-- v3.11: 화면 좁을 때 대비 가로 스크롤 가능하게 감쌈. #문제시 원복 -->
        <HorizontalScrollView
            android:id="@+id/llTopBarRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:fillViewport="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="4dp"
            android:paddingHorizontal="12dp">

            <!-- 속도 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/tvCurrentSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRoadSpeedLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#FF5252"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_speed_limit_hud"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="4dp"/>
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="28dp" android:background="#1A1A1A" android:layout_marginHorizontal="10dp"/>

            <!-- 상태 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/vConnectionDot"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/shape_circle_gray"
                        android:layout_marginEnd="5dp"/>

                    <TextView
                        android:id="@+id/tvActiveStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cruise Off"
                        android:textColor="#CCCCCC"
                        android:textSize="8sp"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvConnectionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="콤마 연결 대기"
                    android:textColor="#CCCCCC"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginTop="1dp"/>
            </LinearLayout>

            <View android:layout_width="16dp" android:layout_height="0dp"/>

            <Button
                android:id="@+id/btnGpsStatus"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="GPS"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:paddingHorizontal="8dp"
                android:backgroundTint="#111111"
                android:layout_marginEnd="8dp"/>

            <ImageButton
                android:id="@+id/btnMuteToggle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:src="@android:drawable/ic_lock_silent_mode"
                android:background="@drawable/shape_circle_gray"
                android:scaleType="center"/>

            <ImageButton
                android:id="@+id/btnOpenSearch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:src="@android:drawable/ic_menu_search"
                android:background="@drawable/shape_circle_gray"
                android:scaleType="center"/>

            <!-- v11.9: 카카오 화면과 동일 - 집/회사를 최근검색 팝업 안에서 상단바 고정
                 버튼으로 이동(재억 요청) - 순서는 검색 -> 집 -> 회사 -> 업로드 -> 메뉴. #문제시 원복 -->
            <ImageButton
                android:id="@+id/btnHomeQuickSlot"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_home_quickslot"
                android:background="@drawable/shape_circle_gray"
                android:scaleType="center"/>

            <ImageButton
                android:id="@+id/btnWorkQuickSlot"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_work_quickslot"
                android:background="@drawable/shape_circle_gray"
                android:scaleType="center"/>

            <!-- v7.9: 로그전송을 더보기(≡) 메뉴 밖으로 빼서 상단바 고정 버튼으로 - 메뉴
                 바로 왼쪽에 배치 (재억 요청). #문제시 원복 -->
            <ImageButton
                android:id="@+id/btnShareLogTopBar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:src="@android:drawable/ic_menu_upload"
                android:background="@drawable/shape_circle_gray"
                android:scaleType="center"/>

            <ImageButton
                android:id="@+id/btnMoreMenu"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_hamburger"
                android:background="@drawable/shape_circle_gray"
                android:scaleType="center"
                android:layout_marginEnd="10dp"/>

            <!-- v4.1: 이벤트는 스크롤 행 안, 메뉴 바로 뒤(맨 끝)에 위치 - 생겼다 없어졌다
                 하는 항목이라 다른 요소를 계속 밀어내지 않게 함 (사용자 요청). #문제시 원복 -->
            <ImageView
                android:id="@+id/ivTopBarEvent"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="3dp"
                android:visibility="gone"
                android:contentDescription="@null"/>

            <TextView
                android:id="@+id/tvTopBarEvent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFC107"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:gravity="center_vertical"
                android:visibility="gone"/>
        </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- v3.0: 보조 패널을 llLeftHudPanel 밖으로 분리해서 화면 위에 뜨는 독립 오버레이로
         만듦 - 펼쳐져도 상단바 높이에 영향 안 줘서 편집모드 드래그 범위가 안 줄어듦
         (사용자 지적 1·2번 근본 해결). #문제시 원복 -->
    <ScrollView
        android:id="@+id/svSecondaryPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="4dp"
        android:visibility="gone"
        android:background="#0D0D0D"
        android:elevation="22dp"
        android:overScrollMode="never"
        android:maxHeight="420dp">

        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
                android:padding="14dp">

                <!-- v7.9: "로그 전송"은 상단바 고정 버튼(btnShareLogTopBar)으로 이동됨 -
                     메뉴 밖으로 뺌 (재억 요청). #문제시 원복 -->

                <Button
                    android:id="@+id/btnEditPanelPosition"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:text="UI 편집"
                    android:textSize="12sp"
                    android:textColor="#CCCCCC"
                    android:gravity="center_vertical|start"
                    android:paddingStart="10dp"
                    android:drawableStart="@drawable/ic_edit_pencil"
                    android:drawableTint="#CCCCCC"
                    android:drawablePadding="10dp"
                    android:backgroundTint="#111111"
                    android:layout_marginBottom="4dp"/>

                <Button
                    android:id="@+id/btnCheckUpdate"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:text="업데이트 확인"
                    android:textSize="12sp"
                    android:textColor="#CCCCCC"
                    android:gravity="center_vertical|start"
                    android:paddingStart="10dp"
                    android:drawableStart="@drawable/ic_refresh"
                    android:drawableTint="#CCCCCC"
                    android:drawablePadding="10dp"
                    android:backgroundTint="#111111"
                    android:layout_marginBottom="4dp"/>

                <Button
                    android:id="@+id/btnHelp"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:text="업데이트 내역"
                    android:textSize="12sp"
                    android:textColor="#CCCCCC"
                    android:gravity="center_vertical|start"
                    android:paddingStart="10dp"
                    android:drawableStart="@drawable/ic_help_info"
                    android:drawableTint="#CCCCCC"
                    android:drawablePadding="10dp"
                    android:backgroundTint="#111111"
                    android:layout_marginBottom="4dp"/>

                <Button
                    android:id="@+id/btnDeleteAllLogs"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:text="로그 전체 삭제"
                    android:textSize="12sp"
                    android:textColor="#CCCCCC"
                    android:gravity="center_vertical|start"
                    android:paddingStart="10dp"
                    android:drawableStart="@drawable/ic_send_paperplane"
                    android:drawableTint="#CCCCCC"
                    android:drawablePadding="10dp"
                    android:backgroundTint="#111111"
                    android:layout_marginBottom="4dp"/>

                <!-- v4.14: 메뉴 순서 조정 - "설정"을 로그 전체 삭제와 도움말 사이로 이동
                     (사용자 요청). #문제시 원복 -->
                <Button
                    android:id="@+id/btnEditKey"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:text="설정"
                    android:textSize="12sp"
                    android:textColor="#CCCCCC"
                    android:gravity="center_vertical|start"
                    android:paddingStart="10dp"
                    android:drawableStart="@drawable/ic_settings_gear"
                    android:drawableTint="#CCCCCC"
                    android:drawablePadding="10dp"
                    android:backgroundTint="#111111"
                    android:layout_marginBottom="4dp"/>

                <Button
                    android:id="@+id/btnGuideHelp"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:text="도움말"
                    android:textSize="12sp"
                    android:textColor="#CCCCCC"
                    android:gravity="center_vertical|start"
                    android:paddingStart="10dp"
                    android:drawableStart="@drawable/ic_guide_book"
                    android:drawableTint="#CCCCCC"
                    android:drawablePadding="10dp"
                    android:backgroundTint="#111111"
                    android:layout_marginBottom="4dp"/>

                <Button
                    android:id="@+id/btnExitApp"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:text="앱 종료"
                    android:textSize="12sp"
                    android:textColor="#EF5350"
                    android:gravity="center_vertical|start"
                    android:paddingStart="10dp"
                    android:drawableStart="@drawable/ic_power_off"
                    android:drawableTint="#EF5350"
                    android:drawablePadding="10dp"
                    android:backgroundTint="#1A0000"/>

                <TextView
                    android:id="@+id/tvAppVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#333333"
                    android:textSize="9sp"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>
        </ScrollView>

    <!-- v3.1: 사용자 요청 - EVENT/SIGNAL/최근검색을 더보기 목록에서 제거하되 내부 로직은 유지. #문제시 원복 -->
    <LinearLayout
        android:id="@+id/llHiddenLegacyPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/llSdiInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView android:id="@+id/tvSdiDescr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--"/>
            <TextView android:id="@+id/tvSdiDist" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--"/>
            <TextView android:id="@+id/tvSdiSpeedLimit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=""/>
        </LinearLayout>

        <View android:id="@+id/vTrafficLight" android:layout_width="12dp" android:layout_height="12dp"/>
        <TextView android:id="@+id/tvCarrotVersion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=""/>
        <TextView android:id="@+id/tvXStateBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=""/>
        <TextView android:id="@+id/tvCarrotIp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="IP: -"/>

        <LinearLayout
            android:id="@+id/llRecentSearchPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView android:id="@+id/tvRecentSearch1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=""/>
            <Button android:id="@+id/btnMoreHistory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+ 더보기"/>
        </LinearLayout>
    </LinearLayout>

    <!-- v3.10: 편집모드 확정 체크버튼 - 항상 화면 위에 떠서 편집을 끝낼 수 있게 함. #문제시 원복 -->
    <ImageButton
        android:id="@+id/btnConfirmEditPosition"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
